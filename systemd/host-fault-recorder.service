[Unit]
Description=Host Fault Recorder — capture per-event kernel fault context and detect bursts
After=network-online.target systemd-journald.service

[Service]
Type=simple
User=user
WorkingDirectory=/srv/agents
ExecStart=/usr/bin/python3 /srv/agents/scripts/host_fault_recorder.py
Environment=PYTHONPATH=/srv/agents:/home/user/.local/lib/python3.12/site-packages
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
